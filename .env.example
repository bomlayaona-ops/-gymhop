# ===== Copy this file to  .env  and fill it in =====
SECRET_KEY=replace_with_a_long_random_secret_key

# --- XAMPP MySQL (start MySQL in the XAMPP Control Panel first) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gymhop_marketplace

# --- Email for the login verification code (Gmail example) ---
# 1) Turn on 2-Step Verification in your Google account
# 2) Google Account > Security > App passwords > create one, paste it below (no spaces)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

